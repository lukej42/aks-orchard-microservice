<!DOCTYPE html>
<html lang="{{ Culture.Name }}">
<head>
    <title>@RenderTitleSegments(Site.SiteName)</title>
    <link rel="stylesheet" href="~/MyProductionTheme/css/bootstrap.min.css">
</head>
<body>
    <nav class="navbar navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">
                <img src="/media/logo.png" width="30" height="30" alt="">
                @Site.SiteName
            </a>
        </div>
    </nav>

    <div class="container mt-4">
        @RenderBody()
    </div>

    <footer class="footer border-top text-muted mt-5">
        <div class="container text-center">
            &copy; @DateTime.Now.Year - @Site.SiteName
        </div>
    </footer>
</body>
</html>